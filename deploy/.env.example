# Copy to /etc/nyabolag.env (chmod 600). Never commit real values.
NYABOLAG_DATA_DIR=/var/lib/nyabolag
BASE_URL=https://example.se
SECRET_KEY=change-me-to-a-long-random-string
# Direct download URL of bolagsverket_bulkfil.zip from Bolagsverket's "Nedladdningsbara filer" page
BULKFILE_URL=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nya bolag <lista@example.se>
ADMIN_EMAIL=you@example.se
# Bolagsverket "API för värdefulla datamängder" (free; Kundanmälan form). Confirm URLs in the e-mail/portal.
HVD_CLIENT_ID=
HVD_CLIENT_SECRET=
HVD_TOKEN_URL=https://portal.api.bolagsverket.se/oauth2/token
HVD_API_BASE=https://gw.api.bolagsverket.se/vardefulla-datamangder/v1
# A reklamspärr check older than this counts as unverified -> company excluded from deliveries
REKLAMSPARR_MAX_AGE_DAYS=30
# e.g. https://hc-ping.com/<uuid>  (Healthchecks.io free tier; alerts if the weekly job doesn't report)
HEALTHCHECK_URL=
